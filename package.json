{
  "name": "planbcareers",
  "version": "1.0.0",
  "description": "Plan B Careers: career guidance and job-search support in Akola and Vidarbha",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "build": "npm run generate && npm run build:css && node scripts/build-public.js && node scripts/validate-public.js",
    "watch": "npx tailwindcss -i ./css/input.css -o ./css/styles.css --watch",
    "test": "node --test tests/*.test.js",
    "generate": "node scripts/generate-core-pages.js && node scripts/generate-job-pages.js && node scripts/generate-category-pages.js && node scripts/generate-discovery.js",
    "build:css": "tailwindcss -i ./css/input.css -o ./css/styles.css --minify",
    "check": "npm run build && npm test"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Asnankhan11/planb-consultancy.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "bugs": {
    "url": "https://github.com/Asnankhan11/planb-consultancy/issues"
  },
  "homepage": "https://planbcareers.in",
  "dependencies": {
    "@libsql/client": "^0.18.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.6",
    "dotenv": "^17.4.2",
    "express": "^4.22.2",
    "express-rate-limit": "^8.6.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.2.0",
    "nodemailer": "^10.4.0",
    "sharp": "^0.35.3",
    "sqlite3": "^6.0.1"
  },
  "devDependencies": {
    "cheerio": "^1.2.0",
    "tailwindcss": "^3.4.19"
  },
  "engines": {
    "node": "24.x"
  }
}
