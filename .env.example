# Plan B Careers — Environment Variables
# Copy this file to .env and fill in real credentials.
# NEVER commit .env to version control.

# === Database ===
# LIBSQL_URL=
# LIBSQL_AUTH_TOKEN=

# === Admin Authentication ===
# JWT_SECRET must be at least 32 characters and NOT 'supersecretplanbkey2026'
# JWT_SECRET=

# === Google Apps Script Integration ===
# GOOGLE_APPS_SCRIPT_URL=
# GOOGLE_APPS_SCRIPT_SECRET=
# GOOGLE_APPS_SCRIPT_VERSION=2

# === SMTP Email Configuration ===
SMTP_HOST=mail.planbcareers.in
SMTP_PORT=465
# SMTP_USER=info@planbcareers.in
# SMTP_PASS=
ADMIN_EMAIL=info@planbcareers.in

# === Application Retry Secret ===
# APPLICATION_ID_SECRET=
